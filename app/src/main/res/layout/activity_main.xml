<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- tajuk -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="H2O"
            android:textColor="#BE185D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Daily Hydration Tracker"
            android:textColor="#9D4C6C"
            android:textSize="14sp" />

        <!-- pilih unit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:padding="12dp">

            <RadioGroup
                android:id="@+id/rgUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMetric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:gravity="center"
                    android:buttonTint="#EC4899"
                    android:text="Metric (kg / ml)"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbImperial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:buttonTint="#EC4899"
                    android:text="Imperial (lbs / oz)"
                    android:textColor="#334155"
                    android:textStyle="bold" />
            </RadioGroup>
        </LinearLayout>

        <!-- input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvWeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight (kg):"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_field_bg"
                android:hint="e.g. 60"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Exercise (Minutes):"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExercise"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field_bg"
                android:hint="e.g. 30"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- target n progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- title + formula popup button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="DAILY TARGET"
                    android:textColor="#DB2777"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFormulaInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="ℹ️ Formula"
                    android:textColor="#BE185D"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetMl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 ml"
                android:textColor="#0F172A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTargetAltUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="0.00 L  •  ~0.0 cups"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Progress: 0 / 0 ml (0%)"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progress" />
        </LinearLayout>

        <!-- quick log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp"
            android:text="Quick Log"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- cawan -->
            <LinearLayout
                android:id="@+id/btnAddGlass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_quick_add"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Cup Icon"
                    android:src="@drawable/ic_cup" />

                <TextView
                    android:id="@+id/tvCupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="+250 ml Glass"
                    android:textColor="#BE185D"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- botol -->
            <LinearLayout
                android:id="@+id/btnAddBottle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_quick_add"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Bottle Icon"
                    android:src="@drawable/ic_bottle" />

                <TextView
                    android:id="@+id/tvBottleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="+500 ml Bottle"
                    android:textColor="#BE185D"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- custom intake -->
        <Button
            android:id="@+id/btnCustomAdd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FCE7F3"
            android:text="+ Log Custom Amount"
            android:textColor="#BE185D"
            android:textStyle="bold" />

        <!-- undo, reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FDF2F8"
                android:text="↶ Undo"
                android:textColor="#BE185D"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#F1F5F9"
                android:text="Reset Today"
                android:textColor="#64748B"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>